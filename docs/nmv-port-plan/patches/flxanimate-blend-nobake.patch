+	 */
+	function maskerBlend(symbol:FlxSymbol, masker:FlxLayer):BlendMode
+	{
+		if (symbol == null || symbol.timeline == null) return null;
+		for (other in symbol.timeline.getList())
+		{
+			if (other == null || other == masker || other._clipper != masker) continue;
+			final b:BlendMode = frameFirstBlend(other._currFrame);

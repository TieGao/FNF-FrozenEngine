diff --git a/flxanimate/animate/SymbolParameters.hx b/flxanimate/animate/SymbolParameters.hx
index c79e734..8aefce1 100644
--- a/flxanimate/animate/SymbolParameters.hx
+++ b/flxanimate/animate/SymbolParameters.hx
@@ -98,6 +98,19 @@ class SymbolParameters implements IFilterable
 
 	public var blendMode(default, set):BlendMode = NORMAL;
 
+	/**
+	 * 不让 `blendMode != NORMAL` 触发 `cacheAsBitmap` 离屏烘焙。
+	 *
+	 * 默认 false = 原行为：带混合的符号先渲染到自己的 filterCamera，再把整块 bitmap
+	 * 用 blendMode 贴回去。这条路径对 Animate 分尸图（尤其 NMV 的 MC 零件）会出错位、
+	 * 糊边，且混合只作用于整块矩形。
+	 *
+	 * 打开后 blend 改由 `FlxAnimate.parseElement` 沿绘制树逐元素实时传下去
+	 * （等价 MaybeMaru flixel-animate 的 `Blend.resolve(this.blend, blend)`）。
+	 * 只有显式打开的资源受影响，其他项目维持原样。
+	 */
+	public var blendNoBake:Bool = false;
+
 	public var cacheAsBitmap(get, set):Bool;
 
 	var _cacheAsBitmap:Bool = false;
@@ -322,7 +335,7 @@ class SymbolParameters implements IFilterable
 		if (type == Graphic) return false;
 
 
-		if (filters != null && filters.length > 0 || blendMode != NORMAL) return true;
+		if (filters != null && filters.length > 0 || (blendMode != NORMAL && !blendNoBake)) return true;
 
 		return _cacheAsBitmap;
 	}
